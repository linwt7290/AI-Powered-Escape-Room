# 可以直接删掉命名中的.example字段，但推荐复制以避免破坏Git中.env.example模板
# Copy this file to .env and fill in your provider's settings.
# Use the API base URL, for example https://api.deepseek.com.
ECHO_API_BASE= https://api.deepseek.com
# Use the model ID provided by your API provider, for example deepseek-flash
ECHO_MODEL= deepseek-flash
# Add your API key only to .env.
ECHO_API_KEY= 
